# Maven build output
target/

# Node / frontend
src/main/client/node_modules/
src/main/client/dist/
src/main/client/dist-ssr/
src/main/client/*.local

# macOS
.DS_Store
**/.DS_Store

# IDE
.idea/
*.iml
.vscode/
*.suo
*.sw?

# Environment / secrets
.env
.env.*
*.env

# Spring Boot config (contains DB credentials)
src/main/resources/application.properties
src/main/resources/application*.properties
src/main/resources/application*.yml

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts
coverage/
**/coverage/
.nyc_output/

# Local temp files
*.tmp
*.temp
*.pid
*.seed
*.stackdump

# Keep empty package directories
!**/.gitkeep
